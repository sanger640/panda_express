<mujoco model="panda_jenga_setup">
  <include file="panda.xml"/>

  <statistic center="0.3 0 0.4" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="block_mat" rgba="0.8 0.6 0.4 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <body name="table" pos="0.5 0 0">
      <geom size="0.2 0.4 0.025" type="box" rgba="0.9 0.9 0.9 1" pos="0 0 0.4"
            mass="1000" contype="1" conaffinity="1"/>
    </body>

    <body name="block_middle" pos="0 0 0">
      <joint type="free"/>
      <geom size="0.0125 0.01 0.0375" type="box" rgba="0.9 0.1 0.1 1" mass="0.05"/>
    </body>
    <body name="block_left" pos="0 0 0">
      <joint type="free"/>
      <geom size="0.0125 0.01 0.0375" type="box" material="block_mat" mass="0.05"/>
    </body>
    <body name="block_right" pos="0 0 0">
      <joint type="free"/>
      <geom size="0.0125 0.01 0.0375" type="box" material="block_mat" mass="0.05"/>
    </body>

    <camera name="cam_fixed" pos="0.9 0 1.2" mode="targetbody" target="table"/>

    <!-- <body name="target" mocap="true" pos="0.5 0 0.5">
        <geom type="sphere" size="0.02" rgba="0 1 0 0.5" contype="0" conaffinity="0"/>
    </body> -->
  </worldbody>

